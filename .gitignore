# Secrets
docs/.readings_pw
docs/.staticrypt.json

# Big archives — too large for GitHub, contain SP25 Canvas student work.
# Keep these on the local machine, don't publish.
old_class_backup.tar.gz
archive/

# ── Student work — NEVER commit/push (privacy/FERPA) ────────────────────────
# Graded submissions live OUTSIDE this repo at ../grading/ (which git cannot
# track). These are a BACKSTOP in case a student-work folder is ever created
# INSIDE the tree by mistake — they are deliberately broad.
grading/
student_submissions/
student-submissions/
submissions/
graded/

# Build / cache
.quarto/
_cache/
__pycache__/
*.pyc
node_modules/
.DS_Store

# Per-week rendered outputs (regenerate with preview_deck.sh / build_slides_*.py)
# HTML is rebuildable from .qmd; the pptx is generated from build_slides_*.py
course/**/week*-slides.html
course/**/week*-slides_files/
course/**/slides/sp26/preview/
# Deck PDFs (weekNN.pdf) ARE tracked — the landing-page schedule links to them.
# Regenerate with course/weekNN/build_slides_*.py or scripts/preview_deck.sh.

# QA scratch
qa-previews/
course/**/week*-audit/

# Build-output JSONs from per-week plot scripts (sample numbers etc.)
course/**/images/samples.json

# Editor
.vscode/
.idea/
*.swp

# Large local authoring artifacts not meant for GitHub
Day01_APS-I_Spr2026.pptx
Day01_APS-I_Spr2026.svg

# SP25 reference .pptx / .pdf files (>50MB) — kept locally, not pushed
course/week09_inverse_rl/slides/Week09_IRLPOMDPSocial.pptx
course/week09_inverse_rl/slides/Week09_IRLSocialCog.pptx
course/week09_inverse_rl/slides/Week09_IRLSocialCog.pdf

# Nested textbook is its own git repo — https://github.com/josephausterweil/probintro
textbook/

# Built by docs/_build.py on every run — regenerated, not authored
docs/slides/week*.html
docs/slides/week*.pdf
docs/slides/week*_files/
docs/slides/sds-reveal/
docs/slides/images/

/.quarto/

# MC assignment verified answer-keys / SP25 solution references (instructor-only, do not publish)
course/assignments/mc/.solution_reference/

**/*.quarto_ipynb

# Synology Drive sync conflict copies (e.g. foo_beancupter_..._Conflict.pptx).
# Never commit these; git-autosync.sh also quarantines them out of the tree.
*_Conflict.*
*-Conflict.*
